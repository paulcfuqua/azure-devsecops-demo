# Local secrets and environment
.env
.env.*
*.local.json
.claude/settings.local.json

# Node
node_modules/
dist/
build/
*.tsbuildinfo

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/

# Bicep build output
*.azrm.json

# OS / editor
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json

# Generated data (seed scripts are source; generated CSVs are artifacts)
data/generated/

# Power Platform solution packages — the repo holds UNPACKED solution source
# (reviewable, diffable); the .zip is a build artifact of export/import.
infra/copilot-studio/solution/*.zip

# Pester result artifacts. `Invoke-Pester -CI` writes testResults.xml by default;
# lint-ci.yml writes pester-results.xml and uploads it. Neither belongs in git —
# both appeared untracked during the 2026-08-26 remediation and were stepped
# around by two separate implementers before being ignored properly.
testResults.xml
pester-results.xml

# Agent working notes and transcripts (~3.3 MB). Until now these were excluded
# only by .superpowers/sdd/.gitignore, one directory down — so moving the
# directory, adding a sibling under .superpowers/, or a single `git add -f`
# would have swept every transcript into a public repository. Ignored at the
# root, where the rule survives a reorganisation.
.superpowers/

# Per-deployment estate identity (prefix, env segment, company name, tags).
# estate.env.example is the template and IS committed; the real one never is.
estate.env
.playwright-mcp/
