{
  "name": "@mls/mcp-tools",
  "version": "0.1.0",
  "private": true,
  "description": "Meridian Launch Systems MCP tool server (L8): the five ops/sec/cost tools exposed over Streamable HTTP for the custom Microsoft Copilot Studio agent to attach as tools. No LLM lives here.",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "tsx evals/run.ts",
    "eval:agent": "tsx evals/run-agent.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.1.0",
    "sql.js": "^1.13.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.13.3",
    "@types/sql.js": "^1.4.9",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
