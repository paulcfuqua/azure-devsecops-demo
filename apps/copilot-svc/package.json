{
  "name": "@mls/copilot-svc",
  "version": "0.1.0",
  "private": true,
  "description": "Meridian Launch Systems copilot service (L8): Anthropic tool-use loop over 5 allowlisted tools, returning renderer JSON component specs (never UI code), validated against @mls/spec-renderer before return.",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "tsx evals/run.ts",
    "eval:live": "tsx evals/run.ts --live"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@mls/spec-renderer": "file:../shared/spec-renderer",
    "express": "^5.1.0",
    "sql.js": "^1.13.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.13.3",
    "@types/sql.js": "^1.4.9",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
