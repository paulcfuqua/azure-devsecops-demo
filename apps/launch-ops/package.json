{
  "name": "@mls/launch-ops",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Meridian Launch Systems launch-ops app: schedule, outcomes, scrub analysis, and fleet reference views rendered from @mls/spec-renderer specs. LOCAL_DATA mode reads data/generated JSON; the ApiProvider targets the L7 SQL/lakehouse-backed API.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fluentui/react-components": "^9.74.6",
    "@microsoft/applicationinsights-web": "^3.4.3",
    "@mls/spec-renderer": "*",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^4.5.2",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vite": "^6.3.5",
    "vitest": "^4.1.11"
  }
}
