{
  "name": "@mls/spec-renderer",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Fixed JSON-spec-to-UI renderer for Meridian Launch Systems apps. The copilot emits JSON component specs (never UI code); this library validates them against spec.schema.json and renders Fluent UI v9 components.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./validate": {
      "types": "./dist/validate.d.ts",
      "import": "./dist/validate.js",
      "require": "./dist/validate.cjs"
    },
    "./spec.schema.json": "./spec.schema.json"
  },
  "files": [
    "dist",
    "spec.schema.json"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json && tsup",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:golden": "node scripts/validate-golden.mjs"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "dependencies": {
    "@fluentui/react-charts": "^9.3.24",
    "@fluentui/react-components": "^9.74.7",
    "ajv": "^8.17.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^26.3.0",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "jsdom": "^30.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.5.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
