# Static serve for the control-tower SPA on port 8080 (ACA ingress target).
#
# This is an nginx TEMPLATE, not a finished config. The nginx:alpine entrypoint
# runs envsubst over /etc/nginx/templates/*.template and writes the result to
# /etc/nginx/conf.d/, substituting only variables that are actually defined in
# the environment — so nginx's own $uri / $host are left untouched.
#
# WHY THE PROXY EXISTS: both frontends' ApiProvider defaults to a same-origin
# base URL of "/api". Without the rule below, /api/feeds/secure-score falls
# through to the SPA fallback and the app receives index.html where it expects
# JSON. Proxying same-origin also means no CORS preflight on the data path.
#
# DATA_API_ORIGIN is set by the L7 deploy to the data-api container app's URL.
# It defaults (in the Dockerfile) to an unreachable loopback port rather than a
# hostname: an unresolvable NAME in proxy_pass stops nginx from starting at all,
# whereas an unreachable ADDRESS lets the app serve normally and fail only the
# API calls with a 502 you can actually diagnose from /healthz's routePrefix.
#
# The Ask tab's Direct Line token endpoint is a separate service and is reached
# by absolute URL (VITE_DIRECTLINE_TOKEN_URL), not through this proxy.
#
# CSP (F11): connect-src has to cover every origin the Ask tab legitimately
# calls, not just Direct Line, or the tab breaks instead of the javascript:
# vector it is meant to close. That is:
#   - 'self'                    /api/* via the proxy below (data-api)
#   - https://*.botframework.com + wss://*.botframework.com
#                                Direct Line 3.0 REST (conversations/activities)
#                                and its streaming websocket -- wildcarded for
#                                the regional hosts VITE_DIRECTLINE_DOMAIN can
#                                select (europe./india.directline.botframework.com)
#   - https://*.azurewebsites.net
#                                the directline-token Function's default
#                                hostname -- VITE_DIRECTLINE_TOKEN_URL is baked
#                                in at build time and reached directly, not
#                                through this proxy (see above), so its origin
#                                has to be allowlisted explicitly
#   - https://js.monitor.azure.com
#     https://*.in.applicationinsights.azure.com
#     https://dc.services.visualstudio.com
#                                the Application Insights Web SDK
#                                (telemetry/browser.ts), loaded whenever
#                                VITE_APPLICATIONINSIGHTS_CONNECTION_STRING is
#                                set: its remote config fetch and its ingestion
#                                endpoint (region-specific, e.g.
#                                eastus-8.in.applicationinsights.azure.com; the
#                                legacy global host is kept for older-style
#                                connection strings with no IngestionEndpoint)
# style-src needs 'unsafe-inline': Fluent UI v9 (Griffel) injects its CSS-in-JS
# via <style> tags with no nonce wired up, and default-src alone does not
# cover style-src -- verified by building this app and loading it under this
# exact policy: a policy without this came back with every Griffel style
# rule rejected and the UI unstyled.
#
# add_header does not merge across nesting levels: a location block that sets
# its own add_header (below, /assets/ sets Cache-Control) stops inheriting the
# server-level ones. So the security headers are repeated in that location too,
# rather than relying on inheritance and silently losing them on hashed assets.
server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' https://*.botframework.com wss://*.botframework.com https://*.azurewebsites.net https://js.monitor.azure.com https://*.in.applicationinsights.azure.com https://dc.services.visualstudio.com; frame-ancestors 'none'; base-uri 'none'" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;

    # Liveness endpoint for ACA probes and V7.1. The content-hash marker is
    # MLS_IMAGE_DIGEST, substituted here by the same envsubst pass and set on the
    # container app by the L7 deploy (infra/bicep/apps/main.bicep). V7.1 compares
    # it against the imageDigest the deploy run recorded, which is what binds
    # "endpoint is up" to "endpoint serves the audited build" — a 200 alone does
    # not satisfy the criterion. Its image default is the literal "unset", so a
    # container deployed outside that path says so instead of pretending.
    location = /healthz {
        default_type text/plain;
        return 200 "ok ${MLS_IMAGE_DIGEST}\n";
    }

    # Data API, same-origin. Trailing slash on proxy_pass strips the /api prefix,
    # so /api/feeds/secure-score reaches the service as /feeds/secure-score.
    location /api/ {
        proxy_pass ${DATA_API_ORIGIN}/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # W3C trace context, so a browser span and the server span join up.
        proxy_set_header traceparent $http_traceparent;
        proxy_set_header tracestate $http_tracestate;
        proxy_connect_timeout 10s;
        proxy_read_timeout 60s;
    }

    # Hashed build assets are immutable. Repeats the security headers set
    # above: this location's own add_header for Cache-Control means it no
    # longer inherits the server block's add_header directives.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' https://*.botframework.com wss://*.botframework.com https://*.azurewebsites.net https://js.monitor.azure.com https://*.in.applicationinsights.azure.com https://dc.services.visualstudio.com; frame-ancestors 'none'; base-uri 'none'" always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy no-referrer always;
        try_files $uri =404;
    }

    # SPA fallback.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
