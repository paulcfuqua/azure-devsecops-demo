{
  "name": "@mls/control-tower",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Meridian Launch Systems control tower: Dev / Sec / Ops posture tabs (Well-Architected framing) rendered from @mls/spec-renderer specs. Local mode uses committed feed fixtures (Dev/Sec) plus data/generated JSON (Ops); the ApiProvider targets the L7/L9 live feeds.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "node tests/render.browser.mjs"
  },
  "dependencies": {
    "@fluentui/react-components": "^9.75.1",
    "@microsoft/applicationinsights-web": "^3.4.6",
    "@mls/spec-renderer": "*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "jsdom": "^30.0.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
