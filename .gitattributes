# Normalize line endings: LF in the repo, native checkout handled by git.
* text=auto

# Scripts and code always LF (CI runs on ubuntu; pwsh handles LF fine on Windows)
*.ps1 text eol=lf
*.psm1 text eol=lf
*.sh text eol=lf
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.bicep text eol=lf
*.md text eol=lf

# Binary
*.png binary
*.jpg binary
*.ico binary
*.woff2 binary
